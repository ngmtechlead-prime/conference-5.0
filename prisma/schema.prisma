generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

generator jsonTypes {
  provider = "prisma-json-types-generator"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum Competition {
  DARE_NIGERIA
  SME_PITCH
  CASE_STUDY
}

enum ApplicationStatus {
  PENDING
  UNDER_REVIEW
  ACCEPTED
  DECLINED
}

enum ConferenceTicketType {
  UNDERGRADUATE
  GRADUATE_PROFESSIONAL
}

enum VolunteerRole {
  TICKET_SALES_REGISTRATION
  PARTNERSHIP_SPONSORSHIP
  MARKETING_COMMUNICATIONS_PUBLICITY
  EVENT_HALL_SELECTION_MANAGEMENT
  HOSPITALITY
  EVENT_MEDICAL_TEAM
  OPERATIONS_TEAM
  TECHNICAL_IT_SUPPORT
  PROGRAMS_TEAM
  PRE_EVENT_TEAM
  COMPETITION_TEAM
  PROTOCOL_LOGISTICS_SECURITY
  VIP_MANAGEMENT
  CREATIVE_GRAPHICS_TEAM
  SALES_ADVERTISEMENT_MERCHANDISE
  OTHER

  // Retained so existing volunteer-interest records remain valid.
  OPERATIONS_TECHNICAL_SUPPORT
  CREATIVE_GRAPHICS_DESIGN
  CONTENT_WRITING_COPYWRITING
  CONFERENCE_OPERATIONS_LOGISTICS
  MARKETING_PROMOTION
  SOCIAL_MEDIA_INFLUENCE_PROMOTION
  MEDIA_PUBLICITY_PUBLIC_RELATIONS
  FUNDRAISING_SPONSORSHIP
  BUSINESS_DEVELOPMENT_CORPORATE_PARTNERSHIPS
  TICKETING_REGISTRATION
  PROGRAMME_PLANNING_COORDINATION
  PHOTOGRAPHY_VIDEOGRAPHY
  VOLUNTEER_COORDINATION_MANAGEMENT
  PROTOCOL_GUEST_RELATIONS
}

enum VolunteerApplicantCategory {
  SECONDARY_SCHOOL_STUDENT
  UNDERGRADUATE_STUDENT
  GRADUATE_STUDENT
  EARLY_CAREER_PROFESSIONAL
  EXPERIENCED_PROFESSIONAL
  OTHER
}

enum VolunteerExperienceLevel {
  NO_FORMAL_EXPERIENCE
  LESS_THAN_ONE_YEAR
  ONE_TO_TWO_YEARS
  THREE_TO_FIVE_YEARS
  SIX_PLUS_YEARS
}

enum VolunteerContributionMode {
  ON_SITE
  REMOTE
  HYBRID_FLEXIBLE
}

enum VolunteerWeeklyCommitment {
  UNDER_THREE_HOURS
  THREE_TO_FIVE_HOURS
  SIX_TO_TEN_HOURS
  MORE_THAN_TEN_HOURS
}

enum VolunteerEventAvailability {
  AVAILABLE
  NEEDS_CONFIRMATION
  NOT_AVAILABLE
}

enum VolunteerInterestStatus {
  NEW
  UNDER_REVIEW
  SHORTLISTED
  CONTACTED
  SELECTED
  WAITLISTED
  NOT_SELECTED
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  fullName  String
  email     String
  subject   String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead])
  @@index([createdAt])
}

model ConferenceRegistration {
  id                      String               @id @default(cuid())
  publicReference         String               @unique
  ticketType              ConferenceTicketType
  firstName               String
  lastName                String
  email                   String
  normalizedEmail         String               @unique
  phoneNumber             String
  gender                  String
  maritalStatus           String
  maritalStatusOther      String?
  residentialAddress      String
  activityOfInterest      String
  discoverySource         String
  discoverySourceOther    String?
  referral                String?
  institutionName         String?
  fieldOfStudy            String?
  studentStatusConfirmed  Boolean?
  professionalInformation String?
  industrySector          String?
  professionalCategory    String?
  privacyConsentAt        DateTime
  privacyNoticeVersion    String
  submissionKeyHash       String               @unique
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  @@index([ticketType])
  @@index([createdAt])
  @@index([discoverySource])
}

model VolunteerInterest {
  id                       String                      @id @default(cuid())
  firstName                String
  lastName                 String
  email                    String
  normalizedEmail          String                      @unique
  phoneNumber              String
  state                    String
  lga                      String
  city                     String
  address                  String
  applicantCategory        VolunteerApplicantCategory
  applicantCategoryOther   String?
  affiliationName          String?
  courseOrJobTitle         String?
  primaryRole              VolunteerRole
  secondaryRole            VolunteerRole?
  otherRoleDescription     String?
  competencies             String[]
  otherCompetency          String?
  experienceLevel          VolunteerExperienceLevel?
  relevantExperience       String?
  hasVolunteeredBefore     Boolean?
  volunteerExperience      String?
  motivation               String?
  proposedContribution     String?
  portfolioUrl             String?
  additionalProfileUrl     String?
  contributionStages       String[]                    @default([])
  contributionMode         VolunteerContributionMode?
  weeklyCommitment         VolunteerWeeklyCommitment?
  availabilityWindows      String[]                    @default([])
  eventAvailability        VolunteerEventAvailability?
  commitmentAcknowledgedAt DateTime?
  privacyConsentAt         DateTime?
  privacyNoticeVersion     String
  status                   VolunteerInterestStatus     @default(NEW)
  adminNotes               String?
  reviewedAt               DateTime?
  reviewedBy               String?
  submissionKeyHash        String                      @unique
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt

  @@index([state])
  @@index([lga])
  @@index([primaryRole])
  @@index([secondaryRole])
  @@index([status])
  @@index([applicantCategory])
  @@index([createdAt])
}

model Application {
  id          String            @id @default(cuid())
  competition Competition
  status      ApplicationStatus @default(PENDING)
  /// [ApplicationData]
  data        Json
  /// [ApplicationFiles]
  files       Json?
  adminNotes  String?
  decidedAt   DateTime?
  decidedBy   String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([competition])
  @@index([status])
  @@index([createdAt])
}
