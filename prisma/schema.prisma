generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

generator jsonTypes {
  provider = "prisma-json-types-generator"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum Competition {
  DARE_NIGERIA
  SME_PITCH
  CASE_STUDY
}

enum ApplicationStatus {
  PENDING
  UNDER_REVIEW
  ACCEPTED
  DECLINED
}

enum ConferenceTicketType {
  UNDERGRADUATE
  GRADUATE_PROFESSIONAL
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  fullName  String
  email     String
  subject   String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead])
  @@index([createdAt])
}

model ConferenceRegistration {
  id                      String               @id @default(cuid())
  publicReference         String               @unique
  ticketType              ConferenceTicketType
  firstName               String
  lastName                String
  email                   String
  normalizedEmail         String               @unique
  phoneNumber             String
  gender                  String
  maritalStatus           String
  maritalStatusOther      String?
  residentialAddress      String
  activityOfInterest      String
  discoverySource         String
  discoverySourceOther    String?
  referral                String?
  institutionName         String?
  fieldOfStudy            String?
  studentStatusConfirmed  Boolean?
  professionalInformation String?
  industrySector          String?
  professionalCategory    String?
  privacyConsentAt        DateTime
  privacyNoticeVersion    String
  submissionKeyHash       String               @unique
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  @@index([ticketType])
  @@index([createdAt])
  @@index([discoverySource])
}

model Application {
  id          String            @id @default(cuid())
  competition Competition
  status      ApplicationStatus @default(PENDING)
  /// [ApplicationData]
  data        Json
  /// [ApplicationFiles]
  files       Json?
  adminNotes  String?
  decidedAt   DateTime?
  decidedBy   String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([competition])
  @@index([status])
  @@index([createdAt])
}
